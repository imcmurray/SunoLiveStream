# Copy to .env and fill in. .env is gitignored — never commit your stream key.

# --- YouTube Live RTMP ---------------------------------------------------
# Get these from YouTube Studio → Create → Go live → Stream settings.
# "Stream URL" is usually rtmp://a.rtmp.youtube.com/live2
# "Stream key" is the secret — paste it here.
YT_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YT_STREAM_KEY=

# --- Encode / output -----------------------------------------------------
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=4500k
AUDIO_MODE=silent          # silent | tone

# --- Local control plane -------------------------------------------------
CONTROL_PORT=8080
DIRECTIVES_FILE=/app/control/directives.json

# --- Dev convenience -----------------------------------------------------
# DRY_RUN=true renders the scene + control server WITHOUT pushing to YouTube.
# Use it to develop the scene with no stream key. Set false to actually stream.
DRY_RUN=true

# encode H.264 on the iGPU (VAAPI) instead of CPU x264 — strongly recommended
# when streaming music (frees CPU for the screencast capture). Needs renderD128.
HW_ENCODE=true

# delay output audio to line up with the eq bars (ms). The video pipeline lags
# the audio; tune this by eye until the bars hit the beat (~2000 on this rig).
AUDIO_DELAY_MS=2000

# --- Real YouTube Live chat (SOURCE=youtube). See docs/youtube-oauth.md ---
# One-time: enable YouTube Data API v3, make an OAuth "Desktop app" client, then
# run `node packages/ingest/src/youtube-auth.js` to get the refresh token.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# YT_LIVE_CHAT_ID=   # optional: pin a chat id instead of auto-discovering
# YT_VIDEO_ID=       # optional: pin THE stream to read chat from — accepts the
#                    # full YouTube URL or the 11-char id (also: live.sh start <url>)

# --- YouTube API quota / polling (defaults are sane; 10k units/day cap) -----
# YT_QUOTA_LIMIT=9000        # stop polling at this many units (leave headroom)
# YT_POLL_ACTIVE_MS=8000     # poll cadence while chat is flowing
# YT_POLL_IDLE_MS=60000      # cadence ramps to this when chat goes quiet
# STREAM_LIKES=on            # on | off — celebrate video-like milestones on the scene
# STREAM_LIKES_POLL_MS=90000

# --- Ingest features (chat → scene) ----------------------------------------
# SOURCE=youtube             # youtube | simulate | live (lifelike fake crowd)
# DIRECTOR=rules             # rules | llm  (llm needs ANTHROPIC_API_KEY)
# MODERATION_LLM=off         # off | anthropic — LLM safety gate on top of the blocklist
# ANTHROPIC_API_KEY=         # for DIRECTOR=llm / MODERATION_LLM=anthropic / MOOD_LLM
# ANTHROPIC_MODEL=           # override the default model
# MUSIC=on                   # on | off — chat Suno links → request queue
# MOOD=on                    # on | off — Collective Mood Engine (aggregate chat → vibe)
# VOTES=on                   # on | off — !theme:x collective theme votes
# REACTIONS=on               # on | off — instant emoji micro-effects

# --- Streamer / capture (advanced) ------------------------------------------
# CAPTURE=screencast         # screencast (GPU path) | x11grab (CPU path)
# STANDBY_ON_BOOT=true       # come up on the "starting shortly" screen + intro loop
# ENABLE_GPU=true            # use the iGPU for Chromium rendering (screencast path)
# GPU_W=1280                 # screencast output size / fps / bitrate
# GPU_H=720
# GPU_FPS=30
# GPU_BITRATE=4500k
# GPU_QP=20                  # VAAPI quality (lower = higher quality + bitrate)
# SCREENCAST_QUALITY=92      # JPEG quality of captured frames
# X264_RC=cbr                # cbr (pad to bitrate, for YouTube) | vbr (file tests)
# OUTPUT_FILE=               # write to a file instead of RTMP (testing)
